# Seguridad Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False

# Dominios permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app

# Base de datos PostgreSQL (Supabase - usar Session Pooler IPv4)
USE_POSTGRES=True
POSTGRES_DB=postgres
POSTGRES_USER=postgres.TU_PROJECT_REF
POSTGRES_PASSWORD=TU_PASSWORD_DE_SUPABASE
POSTGRES_HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
